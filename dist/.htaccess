# ---------------------------------------------------------------------------
# WOLFSE — Apache yapılandırması (SiteGround / public_html)
# Amaç: tek kanonik origin (https://www.wolfse.net) + temiz URL'ler.
# Statik site: dizinler /yol/ -> /yol/index.html olarak servis edilir.
# ---------------------------------------------------------------------------

Options -Indexes -MultiViews
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1a) HTTP -> HTTPS  (SiteGround CDN/proxy uyumlu: X-Forwarded-Proto de kontrol
  #     edilir; aksi halde SSL proxy'de sonlanınca sonsuz döngü oluşur)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1b) www olmayan -> www  (kanonik host)
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) /yol/index.html -> /yol/  (index.html'i URL'den kaldır)
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [L,R=301]

  # 3) Sondaki eğik çizgi: gerçek dizinler için mod_dir (DirectorySlash)
  #    otomatik 301 verir; bu yüzden ek kural gerekmez.
</IfModule>

# ---- 404 ----
ErrorDocument 404 /404.html

# ---- MIME türleri ----
<IfModule mod_mime.c>
  AddType application/json                json webmanifest
  AddType image/svg+xml                   svg svgz
  AddType application/xml                  xml
  AddType text/plain                       txt
  AddType video/mp4                        mp4
  AddCharset UTF-8 .html .css .js .json .xml .txt .webmanifest
</IfModule>

# ---- Sıkıştırma ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/rss+xml
</IfModule>

# ---- Önbellek ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HTML her zaman taze
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Sürümlenmiş/statik varlıklar uzun süre önbelleklenir
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Güvenlik başlıkları
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
