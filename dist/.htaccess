# ---------------------------------------------------------------------------
# WOLFSE — Apache yapılandırması (SiteGround / public_html)
# Amaç: tek kanonik origin (https://www.wolfse.net) + temiz URL'ler.
# Statik site: dizinler /yol/ -> /yol/index.html olarak servis edilir.
# ---------------------------------------------------------------------------

Options -Indexes -MultiViews
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------------
  # 1) Kanonik origin: her zaman https://www.wolfse.net (tek hop)
  # -------------------------------------------------------------------------
  # 1a) Yanlış host (apex / farklı alt alan) -> www. Şema de https'e sabitlenir,
  #     böylece http://wolfse.net/x tek adımda https://www.wolfse.net/x olur.
  RewriteCond %{HTTP_HOST} !^www\.wolfse\.net$ [NC]
  RewriteRule ^ https://www.wolfse.net%{REQUEST_URI} [R=301,L,NE]

  # 1b) http -> https (host zaten www). SiteGround proxy'si SSL'i sonlandırınca
  #     %{HTTPS} güvenilmez olabilir; X-Forwarded-Proto ile döngü engellenir.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.wolfse.net%{REQUEST_URI} [R=301,L,NE]

  # -------------------------------------------------------------------------
  # 2) /yol/index.html -> /yol/  (index.html'i URL'den kaldır)
  # -------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]

  # -------------------------------------------------------------------------
  # 3) Eski İngilizce WordPress içerik sayfaları -> yeni Türkçe karşılık (301)
  #    Bunların gerçek bir eşdeğeri var; bu yüzden 301 (soft-404 değil).
  # -------------------------------------------------------------------------
  RewriteRule ^(contact|contact-us|iletisim-2)/?$  https://www.wolfse.net/iletisim/   [R=301,L,NC]
  RewriteRule ^(about|about-us)/?$                  https://www.wolfse.net/hakkimizda/ [R=301,L,NC]
  RewriteRule ^services(/.*)?$                      https://www.wolfse.net/hizmetler/  [R=301,L,NC]

  # -------------------------------------------------------------------------
  # 4) WordPress kalıntıları -> 410 Gone
  #    Gerçek eşdeğeri YOK. Anasayfaya 301 "soft-404" sayılır; kalıcı silinmiş
  #    içerik için 410 doğru sinyal, Google indeksten daha hızlı düşürür.
  # -------------------------------------------------------------------------
  RewriteRule ^(feed|comments/feed)/?$                         - [G,L,NC]
  RewriteRule ^(hello-world|sample-page)/?$                    - [G,L,NC]
  RewriteRule ^(category|tag|author)(/.*)?$                    - [G,L,NC]
  RewriteRule ^(wp-login|wp-signup|wp-cron|wp-trackback|xmlrpc)\.php$ - [G,L,NC]
  RewriteRule ^wp-[^/]*\.php$                                  - [G,L,NC]
  RewriteRule ^wp-(admin|includes|json)(/.*)?$                 - [G,L,NC]
  RewriteRule ^wp-content/(?!uploads/).*                       - [G,L,NC]
  # Eski WP sorgu-tabanlı permalink'ler (?p=, ?page_id=, ?feed= ...) -> 410
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|feed|cat|attachment_id)=  [NC]
  RewriteRule ^(index\.php)?$                                  - [G,L]

  # -------------------------------------------------------------------------
  # 5) Sayfa-benzeri yol (uzantısız; dosya/dizin değil) sonda '/' yoksa ekle.
  #    Gerçek dizinleri mod_dir (DirectorySlash) zaten 301'ler; burada sadece
  #    dizin olmayan yollar için eğik çizgi tutarlılığı sağlanır.
  # -------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://www.wolfse.net/$1/ [R=301,L,NE]
</IfModule>

# ---- Hata sayfaları ----
ErrorDocument 404 /404.html
# 410 için Apache'nin varsayılan "Gone" yanıtı yeterlidir (noindex sinyali net).

# ---- MIME türleri ----
<IfModule mod_mime.c>
  AddType application/json                json webmanifest
  AddType image/svg+xml                   svg svgz
  AddType application/xml                  xml
  AddType text/plain                       txt
  AddType video/mp4                        mp4
  AddCharset UTF-8 .html .css .js .json .xml .txt .webmanifest
</IfModule>

# ---- Sıkıştırma ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/rss+xml
</IfModule>

# ---- Önbellek ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HTML her zaman taze
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Sürümlenmiş/statik varlıklar uzun süre önbelleklenir
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Güvenlik başlıkları
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
